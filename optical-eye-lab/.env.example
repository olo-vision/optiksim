# OLO-LAB3D – Beispielkonfiguration (ohne echte Werte).
# Kopieren nach .env.local und ausfüllen. .env.local wird NICHT eingecheckt.

# Supabase-Projekt (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
# NUR den Publishable (anon) Key verwenden – niemals den service_role / sb_secret_ Key!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Betriebsart: supabase (Standard, wenn URL + Key gesetzt) | local (Demo ohne Server, keine Lizenzprüfung) | mock (Tests)
# VITE_AUTH_MODE=supabase

# Stripe (Phase 7): Im Frontend gibt es KEINE Stripe-Werte – weder Secret Key noch Price IDs.
# Die Buchung läuft über die Supabase Edge Functions; deren Secrets (STRIPE_SECRET_KEY,
# STRIPE_WEBHOOK_SECRET, SITE_URL) werden ausschließlich in Supabase gesetzt:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_... STRIPE_WEBHOOK_SECRET=whsec_... SITE_URL=http://localhost:5173
# Vorlage für lokale Functions: supabase/functions/.env.example
