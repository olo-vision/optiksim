# Beispielwerte für `supabase functions serve --env-file supabase/functions/.env` (lokal).
# NUR Platzhalter – echte Werte gehören in supabase/functions/.env (gitignored) bzw. in die
# Supabase Function Secrets (Dashboard → Edge Functions → Secrets oder `supabase secrets set`).
# Niemals ins Frontend (.env.local / VITE_*) und niemals ins Git!

STRIPE_SECRET_KEY=sk_test_PLATZHALTER
STRIPE_WEBHOOK_SECRET=whsec_PLATZHALTER
SITE_URL=http://localhost:5173

# optional – nur nötig, wenn andere Preise als die fest hinterlegten Test-Preise gelten sollen
# STRIPE_PRICE_PRIVATE=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_PRICE_EDUCATION=price_...
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
